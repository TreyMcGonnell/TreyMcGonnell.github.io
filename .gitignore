# --- Local runtime data (question log, caches)
/.data/

# --- Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# --- Build output, caches, tooling
node_modules/
dist/
build/
.vite/
coverage/
playwright-report/
test-results/
.lighthouseci/
__pycache__/
*.py[cod]
.pytest_cache/
