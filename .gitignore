venv/
.modal/

# --- OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# web test output (fixture content is generated by code at test time)
/web/tests/.content/
/web/dist-e2e/
/web/test-results/
/web/playwright-report/
/web/dist-artifact/
